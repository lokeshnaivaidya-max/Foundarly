{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://rfyxnshvtfswvaogjzwq.supabase.co wss://rfyxnshvtfswvaogjzwq.supabase.co https://tzihsuzxwziirpkvxysr.supabase.co wss://tzihsuzxwziirpkvxysr.supabase.co https://api.razorpay.com https://generativelanguage.googleapis.com; frame-src 'self' https://api.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/consultants",
      "destination": "/index.html"
    },
    {
      "source": "/consultants/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/consultant",
      "destination": "/index.html"
    },
    {
      "source": "/consultant/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/booking",
      "destination": "/index.html"
    },
    {
      "source": "/my-bookings",
      "destination": "/index.html"
    },
    {
      "source": "/network",
      "destination": "/index.html"
    },
    {
      "source": "/network/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/faqs",
      "destination": "/index.html"
    },
    {
      "source": "/apply-consultant",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/networking-terms",
      "destination": "/index.html"
    },
    {
      "source": "/camera-test",
      "destination": "/index.html"
    },
    {
      "source": "/meeting/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/review/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/upi-payment",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    }
  ]
}
