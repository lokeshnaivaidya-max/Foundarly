<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0a0c"/>
      <stop offset="50%" stop-color="#141418"/>
      <stop offset="100%" stop-color="#08080a"/>
    </linearGradient>

    <!-- Gold Accent Gradient -->
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F5A623"/>
      <stop offset="100%" stop-color="#D48812"/>
    </linearGradient>

    <!-- Subtle Glow -->
    <radialGradient id="goldGlow" cx="50%" cy="30%" r="50%">
      <stop offset="0%" stop-color="#F5A623" stop-opacity="0.18"/>
      <stop offset="100%" stop-color="#F5A623" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bgGrad)"/>
  <circle cx="600" cy="220" r="450" fill="url(#goldGlow)"/>

  <!-- Border Frame -->
  <rect x="30" y="30" width="1140" height="570" rx="24" fill="none" stroke="#26262b" stroke-width="2"/>
  <rect x="30" y="30" width="1140" height="570" rx="24" fill="none" stroke="#F5A623" stroke-width="1" stroke-opacity="0.3"/>

  <!-- Brand Pill -->
  <g transform="translate(600, 110)">
    <rect x="-140" y="-20" width="280" height="40" rx="20" fill="#1f1a14" stroke="#F5A623" stroke-width="1.5" stroke-opacity="0.6"/>
    <text x="0" y="6" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="700" fill="#F5A623" letter-spacing="3" text-anchor="middle">BY FOUNDERS • FOR FOUNDERS</text>
  </g>

  <!-- Title / Logo -->
  <text x="600" y="240" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="76" font-weight="900" fill="url(#goldGrad)" text-anchor="middle" letter-spacing="-1.5">Foundarly</text>

  <!-- Subtitle -->
  <text x="600" y="310" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="30" font-weight="600" fill="#ffffff" text-anchor="middle" letter-spacing="-0.5">1-on-1 Strategic Advisory &amp; Verified Consultation</text>

  <!-- Description Body -->
  <text x="600" y="370" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="20" font-weight="400" fill="#9ca3af" text-anchor="middle">
    Connect with industry leaders, scale your startup, and get verified strategic clarity.
  </text>
  <text x="600" y="405" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="19" font-weight="400" fill="#9ca3af" text-anchor="middle">
    Includes authoritative 7-day session rejoin &amp; seamless follow-up scheduling.
  </text>

  <!-- Feature Tags -->
  <g transform="translate(600, 480)">
    <!-- Tag 1 -->
    <rect x="-360" y="-18" width="220" height="38" rx="10" fill="#18181c" stroke="#2c2c34" stroke-width="1"/>
    <text x="-250" y="7" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="15" font-weight="600" fill="#e5e7eb" text-anchor="middle">✓ Verified Experts</text>

    <!-- Tag 2 -->
    <rect x="-110" y="-18" width="220" height="38" rx="10" fill="#18181c" stroke="#2c2c34" stroke-width="1"/>
    <text x="0" y="7" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="15" font-weight="600" fill="#e5e7eb" text-anchor="middle">⚡ Real-Time Video Call</text>

    <!-- Tag 3 -->
    <rect x="140" y="-18" width="220" height="38" rx="10" fill="#18181c" stroke="#2c2c34" stroke-width="1"/>
    <text x="250" y="7" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="15" font-weight="600" fill="#e5e7eb" text-anchor="middle">🛡️ End-to-End Security</text>
  </g>

  <!-- Footer Link -->
  <text x="600" y="565" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="16" font-weight="500" fill="#F5A623" text-anchor="middle">https://www.foundarlybusinessworld.in</text>
</svg>
